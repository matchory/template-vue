{
  "permissions": {
    "allow": [
      "Bash(pnpm run fmt)",
      "Bash(pnpm run fmt:check)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run check)",
      "Bash(pnpm test)",
      "Bash(pnpm run build)",
      "Bash(pnpm run style:verify)",
      "Bash(pnpm install)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; [ -n \"$f\" ] && pnpm exec oxfmt \"$f\" >/dev/null 2>&1 || true; }"
          }
        ]
      }
    ]
  }
}
